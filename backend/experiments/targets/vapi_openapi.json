{
  "openapi": "3.0.0",
  "info": {
    "title": "vAPI - Vulnerable Adversely Programmed Interface",
    "description": "Hand-authored minimal OpenAPI spec for vAPI (github.com/roottusk/vapi). vAPI does not ship a machine-readable spec. This spec covers only the endpoints under AuthzGraph cross-app validation testing. Full auto-discovery of undocumented targets is future work.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "vAPI local instance"
    }
  ],
  "paths": {
    "/api1/user/{id}": {
      "get": {
        "summary": "Get user by ID (BOLA vulnerability: no ownership check)",
        "description": "vAPI1: User ID can be enumerated sequentially. No authorization check verifies the requester owns the requested user object.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "User object ID (vulnerable to enumeration)"
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User object returned (unauthorized cross-user access possible)" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        },
        "x-authzgraph-tags": {
          "vulnerability_class": "BOLA",
          "object_id_param": "id",
          "writable_fields": [],
          "admin_path": false
        }
      }
    },
    "/api1/user": {
      "post": {
        "summary": "Create user (baseline legitimate operation)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" },
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "User created" }
        }
      }
    },
    "/api5/users": {
      "get": {
        "summary": "Get all users without administrative authorization (BFLA vulnerability)",
        "description": "vAPI5: List all users returned to any authenticated user without administrative role check.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "All users returned without admin authorization check" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        },
        "x-authzgraph-tags": {
          "vulnerability_class": "BFLA",
          "admin_path": true,
          "object_id_param": null,
          "writable_fields": []
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
